# Non-secret placeholder values (see .env.example) — committed so `pnpm
# test` can exercise VITE_*-driven code (lib/config.ts) from a clean
# checkout. Vitest defaults to `mode: 'test'`, which makes it load this file
# the same way Vite loads .env/.env.local for `dev`/`build`. Never a
# substitute for real values in .env.local when actually running the app.
VITE_COGNITO_USER_POOL_ID=us-east-1_TESTPOOL00
VITE_COGNITO_CLIENT_ID=test-client-id
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000
VITE_MAIL_BUCKET_NAME=thoughtreps-test-bucket
VITE_AWS_REGION=us-east-1
VITE_MAILBOX_ADDRESSES=hello@example.com,support@example.com
VITE_API_URL=https://test.execute-api.us-east-1.amazonaws.com
