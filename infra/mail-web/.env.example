# None of these are secrets — all safe to embed in a client bundle. Copy this
# file to .env.local and fill in the real values from the ThoughtReps-prod-Mail
# stack's outputs (scripts/deploy-mail-web.sh does this for deploys).

VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=1example23456789example
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000
VITE_MAIL_BUCKET_NAME=thoughtreps-example-bucket
VITE_AWS_REGION=us-east-1
VITE_MAILBOX_ADDRESSES=hello@thoughtreps.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
